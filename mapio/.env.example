# ─────────────────────────────────────────────────────────────────────────────
# MAPIO environment. Copy to .env.local for development. NEVER commit real values.
# Every integration has a demo adapter; anything left empty uses it in development.
# In production (NODE_ENV=production) missing credentials FAIL LOUDLY unless
# MAPIO_DEMO_MODE=true (labelled demo deployments only).
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000                # public origin (used in auth/billing redirects)
SESSION_SECRET=                              # >=32 random chars (openssl rand -base64 48). Required in prod.
MAPIO_DEMO_MODE=                             # "true" only for a labelled demo deployment
ADMIN_EMAILS=                                # comma-separated; promoted to admin on sign-in (audited)
NEXT_PUBLIC_SUPPORT_EMAIL=                   # shown on /contact
SIGNUP_LIMIT_PER_HOUR=5                      # per-IP sign-up throttle

# Database — Supabase Postgres connection string (Settings → Database → Connection string,
# "Transaction pooler" URI). Empty in dev → embedded PGlite at .data/pglite (same migrations).
DATABASE_URL=
MAPIO_DEV_DB_DIR=                            # dev only; "memory" for an in-memory DB

# Supabase Auth + Realtime (Project Settings → API). Empty in dev → local dev auth adapter.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=        # publishable (anon) key — safe for the browser
SUPABASE_SECRET_KEY=                         # secret/service key — SERVER ONLY (account deletion)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=             # "true" after enabling Google in Supabase Auth → Providers

# Map tiles — MapTiler Cloud commercial plan (https://cloud.maptiler.com/account/keys/)
# Restrict the key to your production/preview origins in the MapTiler dashboard.
NEXT_PUBLIC_MAPTILER_KEY=
MAPTILER_STYLE_DARK=streets-v2-dark
MAPTILER_STYLE_LIGHT=streets-v2
MAP_STYLE_PROVIDER=                          # override: maptiler | openfreemap (dev) | fixture (offline)

# Search + routing — Geoapify (https://myprojects.geoapify.com/) — SERVER ONLY
GEOAPIFY_API_KEY=

# Weather — Open-Meteo commercial customer API key (https://open-meteo.com/en/pricing) — SERVER ONLY
OPEN_METEO_API_KEY=
OPEN_METEO_ALLOW_FREE_TIER=                  # "true" = free endpoint for NON-COMMERCIAL local dev only

# Chargers — Open Charge Map (https://openchargemap.org/site/develop/api) — SERVER ONLY
OPEN_CHARGE_MAP_API_KEY=

# Exchange rates — National Bank of Georgia (public, no key). "fixture" = offline demo values.
FX_PROVIDER=

# Billing — Paddle Billing (https://developer.paddle.com/). Sandbox first.
BILLING_PROVIDER=                            # "dev" forces the local simulator (dev/demo only)
PADDLE_ENVIRONMENT=sandbox                   # sandbox | production
PADDLE_API_KEY=                              # Developer tools → Authentication — SERVER ONLY
PADDLE_WEBHOOK_SECRET=                       # Notifications → destination → secret key — SERVER ONLY
PADDLE_PRICE_ID=                             # pri_… monthly price WITH a 7-day trial period
PADDLE_PRICE_ID_NO_TRIAL=                    # pri_… same price WITHOUT trial (returning customers)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=             # Developer tools → Authentication → client-side token
DEV_BILLING_WEBHOOK_SECRET=dev_only_webhook_secret_change_me

# Display fallbacks (used only when the provider price can't be read)
DISPLAY_PRICE_AMOUNT_MINOR=600
DISPLAY_PRICE_CURRENCY=USD
TRIAL_DAYS=7

# Vercel Cron → /api/cron/reconcile (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=
